        <!-- Primary brand color (Orange FLM) -->
        <item name="colorPrimary">@color/macarena_orange_primary</item>
        <item name="colorPrimaryVariant">@color/dark_bg</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/macarena_orange_primary</item>
        <item name="colorSecondaryVariant">@color/macarena_orange_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="@color/dark_input_bg" />
            <stroke android:width="1.5dp" android:color="@color/macarena_orange_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="@color/dark_input_bg" />
            <stroke android:width="1dp" android:color="@color/dark_input_stroke" />
        </shape>
    </item>
</selector>


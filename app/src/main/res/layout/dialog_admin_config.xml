<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestión de Dispositivo (TI)"
            android:textColor="@color/macarena_orange_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Parámetros técnicos de enlace y telemetría de activos."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Tarjeta de Estado y Diagnóstico Actual -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvDiagStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTADO: ENROLADO"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/status_ok" />

                <TextView
                    android:id="@+id/tvDiagCoords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Coordenadas: 4.7095, -74.0617"
                    android:textSize="12sp"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/tvDiagLastHeartbeat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Último latido: Esperando sincronización..."
                    android:textSize="12sp"
                    android:textColor="#666666" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDiagSync"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="10dp"
                    android:text="Sincronizar Latido Ahora"
                    android:textSize="11sp"
                    app:cornerRadius="19dp"
                    android:backgroundTint="@color/macarena_orange_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Campo: Placa -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Placa / Serial del Activo"
            app:boxStrokeColor="@color/macarena_orange_primary"
            app:hintTextColor="@color/macarena_orange_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPlaca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo: Servidor URL -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="URL del Backend Receptor"
            app:boxStrokeColor="@color/macarena_orange_primary"
            app:hintTextColor="@color/macarena_orange_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo: API Key -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="API Key (X-Device-Api-Key)"
            app:boxStrokeColor="@color/macarena_orange_primary"
            app:hintTextColor="@color/macarena_orange_primary"
            app:passwordToggleEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo: Intervalo -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Intervalo de latido (minutos)"
            app:boxStrokeColor="@color/macarena_orange_primary"
            app:hintTextColor="@color/macarena_orange_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1"
                android:text="15" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
